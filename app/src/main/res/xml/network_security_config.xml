<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext (HTTP) traffic anywhere. Only system-trusted HTTPS certificates. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
